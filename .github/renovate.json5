{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    // https://github.com/edgarrmondragon/.github/blob/main/renovate/uv.json5
    "edgarrmondragon/.github//renovate/base.json5",
  ],

  "packageRules": [
    {
      "matchManagers": ["pip-compile"],
      "groupName": "Pinned Python plugin dependencies",
      "groupSlug": "pip-compile",
    },
  ],

  "customManagers": [
    {
      // pip_url: tap-foo[pinned]==1.2.3 in meltano.yml and pkl/**/*.pkl
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|\/)meltano\\.yml$/",
        "/(^|\/)pkl\/.+\\.pkl$/",
      ],
      "matchStrings": [
        "pip_url(?:: | = )\"?(?<depName>[a-zA-Z0-9._-]+)\\[pinned\\]==(?<currentValue>[^\\s\"]+)\"?",
      ],
      "datasourceTemplate": "pypi",
    },
  ],

  // https://docs.renovatebot.com/configuration-options/#prconcurrentlimit
  "prConcurrentLimit": 1,

  // https://docs.renovatebot.com/modules/manager/pip-compile/#non-configured-managerfilepatterns
  "pip-compile": {
    "managerFilePatterns": [
      "/(^|\/)plugins\/requirements\/requirements\\.[a-z0-9-]+\\.txt$/",
      "/(^|\/)quarto\/requirements\\.txt$/",
    ],
    "lockFileMaintenance": {
      "enabled": true,
      "branchTopic": "pip-compile-refresh",
      "commitMessageAction": "Refresh pip-compile outputs",
      "schedule": [
        "* * 1 */3 *",  // At every minute on day-of-month 1 in every 3rd month
      ],
    },
  },

  "pip_requirements": {
    "enabled": false
  },
}
