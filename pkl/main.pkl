import "lib/meltano/project.pkl"
import "lib/meltano/plugin.pkl"

import "plugins/extractors/tap_stackexchange.pkl"
import "plugins/extractors/tap_readthedocs.pkl"
import "plugins/extractors/tap_github.pkl"
import "plugins/extractors/tap_pypistats.pkl"

DAILY_INTERVAL = "0 12 * * *"

output {
  value = new project.MeltanoProject {
    default_environment = "dev"
    project_id = "b77cad0a-ffd8-494e-9e6b-18d6eacb71d4"
    ff = new project.FeatureFlags {
      plugin_locks_required = true
    }
    project_readonly = true
    requires_meltano = ">=4.4"
    venv = new project.VirtualEnvironments {
      backend = "uv"
    }
    plugins = new project.Plugins {
      extractors = List(
        tap_stackexchange.tap_stackexchange,
        tap_readthedocs.tap_readthedocs,
        tap_github.tap_github,
        tap_pypistats.tap_pypistats
      )
      loaders = List(
        new plugin.Loader {
          name = "target-jsonl"
          variant = "andyh1203"
          pip_url = "-r $MELTANO_PROJECT_ROOT/plugins/requirements/requirements.target-jsonl.txt"
          config = new Mapping {
            ["destination_path"] = "output/$MELTANO_EXTRACTOR_NAMESPACE"
          }
        },
        new plugin.Loader {
          name = "target-ducklake"
          namespace = "target_ducklake"
          executable = "target-ducklake"
          pip_url = "-r $MELTANO_PROJECT_ROOT/plugins/requirements/requirements.target-ducklake.txt"
          capabilities = List("about")
          settings = List(
            new plugin.Setting { name = "catalog"; kind = "string"; sensitive = true },
            new plugin.Setting { name = "data_path"; kind = "string" },
            new plugin.Setting { name = "default_target_schema"; kind = "string" },
            new plugin.Setting { name = "run_maintenance"; kind = "boolean" },
            new plugin.Setting { name = "s3_endpoint"; kind = "string" },
            new plugin.Setting { name = "s3_region"; kind = "string" },
            new plugin.Setting { name = "s3_url_style"; kind = "string" },
            new plugin.Setting { name = "s3_access_key_id"; kind = "string"; sensitive = true },
            new plugin.Setting { name = "s3_secret_access_key"; kind = "string"; sensitive = true }
          )
          config = new Mapping {
            ["catalog"] = "postgres:$NEON_DATABASE_URL"
            ["data_path"] = "s3://ducklake/warehouse/"
            ["default_target_schema"] = "$MELTANO_EXTRACT__LOAD_SCHEMA"
            ["s3_endpoint"] = "$AWS_ENDPOINT_URL_S3"
            ["s3_region"] = "$AWS_REGION"
            ["s3_url_style"] = "path"
            ["s3_access_key_id"] = "$AWS_ACCESS_KEY_ID"
            ["s3_secret_access_key"] = "$AWS_SECRET_ACCESS_KEY"
          }
        }
      )
      utilities = List(
        new plugin.Utility {
          name = "dbt"
          variant = "dbt-labs"
          namespace = "dbt"
          pip_url = "-r $MELTANO_PROJECT_ROOT/plugins/requirements/requirements.dbt.txt"
          commands = new Mapping {
            ["lint"] = new plugin.Command {
              args = "lint"
              description = "Lint SQL files"
            }
            ["build"] = new plugin.Command {
              args = "build"
              description = "Will run your models, tests, snapshots and seeds in DAG order"
            }
          }
        }
      )
    }
    environments = List(
      new project.MeltanoEnvironment {name = "dev"},
      new project.MeltanoEnvironment {name = "staging"},
      new project.MeltanoEnvironment {
        name = "prod"
        env = new Mapping {
          ["MELTANO_FF_PLUGIN_LOCKS_REQUIRED"] = "true"
          ["MELTANO_FF_STRICT_ENV_VAR_MODE"] = "true"
        }
      }
    )
    jobs = List(
      new project.Job {
        name = "stackoverflow-to-duckdb"
        tasks = List("tap-stackexchange target-ducklake")
      },
      new project.Job {
        name = "rtd-to-duckdb"
        tasks = List("tap-readthedocs target-ducklake")
      },
      new project.Job {
        name = "gh-to-duckdb"
        tasks = List("tap-github target-ducklake")
      },
      new project.Job {
        name = "pypistats-to-duckdb"
        tasks = List("tap-pypistats target-ducklake")
      }
    )
  }
}
