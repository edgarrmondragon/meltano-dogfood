module tap_github

import "../../lib/meltano/plugin.pkl"

tap_github = new plugin.Extractor {
  name = "tap-github"
  variant = "meltanolabs"
  pip_url = "-r $MELTANO_PROJECT_ROOT/plugins/requirements/requirements.tap-github.txt"
  config = new Mapping {
    ["organizations"] = List(
      "reservoir-data"
    )
    ["start_date"] = "1 month ago"
    ["user_agent"] = "$MELTANO_USER_AGENT"
  }
  select = List(
    "repositories.*"
  )
}
